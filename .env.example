# SQLite file (relative to the project root). Switch to Postgres later by changing the
# Prisma datasource provider and this URL.
DATABASE_URL="file:./prisma/dev.db"

# Secret used to hash visitor IPs for rate limiting. Raw IPs are never stored.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
IP_HASH_SALT="change-me"
