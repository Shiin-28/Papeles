# Local development: a SQLite file (relative to the project root).
# Hosted (e.g. Vercel): a Turso libSQL URL like "libsql://your-db-name-yourname.turso.io".
DATABASE_URL="file:./prisma/dev.db"

# Only for a hosted Turso database. Leave empty for the local file.
DATABASE_AUTH_TOKEN=""

# Secret used to hash visitor IPs for rate limiting. Raw IPs are never stored.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
IP_HASH_SALT="change-me"
